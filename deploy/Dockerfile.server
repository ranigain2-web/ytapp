# Dockerfile.server — ytapp backend (yt-api + PO-token provider in one container)
# Build:   docker build -f deploy/Dockerfile.server -t ytapp-server .
# Run:     docker run -p 3001:3001 ytapp-server
# Compose: docker compose -f deploy/docker-compose.yml up -d
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- yt-api dependencies ---
COPY server/package.json ./server/
RUN cd server && npm install --omit=dev --no-audit --no-fund && npm cache clean --force

# --- PO-token provider dependencies (vendored bgutil v2.0.0 build) ---
COPY pot-provider/package.json ./pot-provider/
RUN cd pot-provider && npm install --omit=dev --no-audit --no-fund && npm cache clean --force

# --- application code ---
COPY server/index.mjs ./server/
COPY pot-provider/build ./pot-provider/build
COPY deploy/start-stack-docker.sh ./start.sh
RUN chmod +x start.sh

ENV PORT=3001 \
    POT_PORT=4416 \
    URL_SUFFIX="" \
    NODE_ENV=production

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -s -m 4 http://127.0.0.1:${PORT}/api/health | grep -q '"ok":true' || exit 1

CMD ["bash", "start.sh"]
